{
  "manifest_version": 3,
  "name": "Unsecure Websites Scanner",
  "version": "1.0",
  "description": "Warns users about risky websites.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": "src/icon.png"
  },
  "icons": {
    "128": "src/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["RiskyShops.csv"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}